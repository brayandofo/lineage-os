name: Compilar Android Do Zero

on:
  workflow_dispatch: # Abre um botao para voce clicar e iniciar quando quiser

jobs:
  build:
    runs-on: ubuntu-22.04

    steps:
    - name: Limpar Espaco Interno do Servidor
      uses: easimon/maximize-build-space@master
      with:
        root-reserve-mb: 4096
        swap-size-mb: 1024
        remove-dotnet: 'true'
        remove-android: 'true'
        remove-haskell: 'true'

    - name: Instalar Dependencias do Ubuntu
      run: |
        sudo dpkg --add-architecture i386
        sudo apt-get update
        sudo apt-get install -y git openjdk-17-jdk python3 repo make bc bison curl flex g++ gperf libncurses5-dev libssl-dev libxml2-utils unzip zip zlib1g-dev zlib1g-dev:i386 ccache lzop rsync

    - name: Configurar Ferramenta Repo e Identidade
      run: |
        mkdir -p ~/bin
        curl https://googleapis.com > ~/bin/repo
        chmod a+x ~/bin/repo
        export PATH=~/bin:$PATH
        git config --global user.name "Brayan"
        git config --global user.email "brayan@example.com"

    - name: Baixar Codigo Fonte do LineageOS 19.1
      run: |
        mkdir ~/lineage-gsi && cd ~/lineage-gsi
        ~/bin/repo init -u https://github.com -b lineage-19.1 --depth=1 --git-lfs --no-clone-bundle
        ~/bin/repo sync -c -j4 --no-tags --no-clone-bundle

    - name: Rodar Compilacao Real da GSI (ARM32 + Binder64)
      run: |
        cd ~/lineage-gsi
        source build/envsetup.sh
        lunch lineage_a64_ab-userdebug
        export CCACHE_DISABLE=1
        make systemimage -j$(nproc)

    - name: Compactar Imagem system.img Criada
      run: |
        cd ~/lineage-gsi/out/target/product/* || true
        zip -r meu_android_do_zero.zip system.img

    - name: Disponibilizar Link de Download
      uses: actions/upload-artifact@v4
      with:
        name: Minha-GSI-Do-Zero
        path: ~/lineage-gsi/out/target/product/*/*.zip
